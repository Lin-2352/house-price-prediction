# Kaggle credentials — never commit
.kaggle/
kaggle.json
access_token

# Data (raw/interim are gitignored; only small model artifacts are committed)
data/raw/
data/interim/
data/processed/

# Full CV leaderboard (all 3 candidate models incl. an 800-tree RF) is

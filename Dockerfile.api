# Used for local memory-footprint verification (docker run --memory=512m)
# before deploying to Render; Render itself builds from render.yaml
# directly (buildCommand/startCommand), not from this file.
FROM python:3.11-slim

WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY api/ api/
COPY web/ web/
COPY src/ src/
COPY artifacts/india/api_bundle.joblib artifacts/india/api_bundle.joblib
COPY artifacts/india/metrics.json artifacts/india/metrics.json

ENV PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port $PORT"]
